# Copy to .github/workflows/kernel.yml when the GitHub repository is created.
# Requires a self-hosted runner with the labels below, sudo for
# makechrootpkg/mkarchroot, keys/env.sh and the SourceForge SSH key.
name: x-kernel

on:
  schedule:
    - cron: "0 7 * * *"
  workflow_dispatch:
    inputs:
      channel:
        description: Arch channel
        type: choice
        options: [stable, testing]
        default: stable
      publish:
        description: Publish to SourceForge after review
        type: boolean
        default: false

permissions:
  contents: read

jobs:
  build:
    runs-on: [self-hosted, linux, x64, x-kernel]
    outputs:
      update: ${{ steps.check.outputs.update }}
    steps:
      - uses: actions/checkout@v4

      - name: Check Arch version
        id: check
        env:
          CHANNEL: ${{ github.event.inputs.channel || 'stable' }}
        run: |
          set +e
          ./scripts/check-upstream.sh --channel "$CHANNEL" --json > check.json
          rc=$?
          cat check.json
          set -e
          if [ "$rc" -eq 0 ]; then
            echo "update=false" >> "$GITHUB_OUTPUT"
          elif [ "$rc" -eq 10 ]; then
            echo "update=true" >> "$GITHUB_OUTPUT"
          else
            exit "$rc"
          fi

      - name: Build and sign
        if: steps.check.outputs.update == 'true' || github.event.inputs.publish == 'true'
        env:
          CHANNEL: ${{ github.event.inputs.channel || 'stable' }}
        run: |
          if [ "${{ github.event.inputs.publish }}" = "true" ]; then
            ./scripts/release.sh --channel "$CHANNEL" --force
          else
            ./scripts/release.sh --channel "$CHANNEL"
          fi

      - uses: actions/upload-artifact@v4
        if: steps.check.outputs.update == 'true' || github.event.inputs.publish == 'true'
        with:
          name: x-kernel-out
          path: out/
          if-no-files-found: error

  publish:
    needs: build
    if: github.event.inputs.publish == 'true'
    runs-on: [self-hosted, linux, x64, x-kernel]
    environment: kernel-release
    steps:
      - uses: actions/checkout@v4

      - uses: actions/download-artifact@v4
        with:
          name: x-kernel-out
          path: out

      - name: Publish
        run: ./scripts/publish.sh --yes --from out
