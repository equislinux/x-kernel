# Copy to config.env and adjust. config.env is gitignored.
# Do not put keys or tokens here: only paths and non-secret settings.

# Variant and architecture.
# stable  -> Arch core/linux, package linux-x, repo [x-kernel]
# testing -> Arch core-testing/linux, package linux-x, repo [x-kernel]
# mainline-> AUR linux-mainline, package linux-x-mainline, repo [x-kernel-mainline]
ARCH=x86_64
CHANNEL=stable

# Upstream recipes. stable/testing use Arch's packaging tags; mainline follows
# the AUR linux-mainline HEAD (currently 7.4rc1-1).
UPSTREAM_REPO=https://gitlab.archlinux.org/archlinux/packaging/packages/linux.git
AUR_MAINLINE_REPO=https://aur.archlinux.org/linux-mainline.git

# Clean chroot and local caches. Output is out/<pkgbase>/<channel>/.
CHROOT=/var/lib/archbuild/x-kernel-x86_64
WORKDIR=work
OUTDIR=out
REPODIR=repo
SRCDEST=work/sources

# Signing material (outside this repository)
KEYS_ENV=../keys/env.sh        # relative to this repo or absolute

# SourceForge FRS. SF_PATH/SF_BASE_URL are derived from CHANNEL:
#   stable/testing -> /home/frs/project/equislinux/kernel
#   mainline       -> /home/frs/project/equislinux/kernel-mainline
# Override only if you really need a different location.
SF_USER=xscriptor
SF_KEY=~/.ssh/id_ed25519_sourceforge
SF_ARCH=x86_64

# The following are derived automatically; uncomment to override.
# PKGBASE=linux-x
# REPO_NAME=x-kernel
# SF_PATH=/home/frs/project/equislinux/kernel
# SF_BASE_URL=https://downloads.sourceforge.net/project/equislinux/kernel/x86_64
